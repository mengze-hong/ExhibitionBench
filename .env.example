# ============================================================
# ExhibitionBench — Environment Variables Template
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file.
# ============================================================

# ── Option A: Any OpenAI-compatible OpenAI-compatible gateway (recommended) ───────────
# Point to your own OpenAI-compatible proxy, or any compatible service.
# Examples:
#   Self-hosted: http://localhost:4000
#   Groq:        https://api.groq.com/openai/v1
#   Together AI: https://api.together.xyz/v1
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=YOUR_API_KEY_HERE

# ── Option B: Open-weight models via a separate OpenAI-compatible endpoint ──
# Used for Llama / Qwen served via vLLM, Ollama, or any provider.
# If you only have one endpoint, set both to the same value.
# Example (Ollama local):
#   LLM_OPENWEIGHT_API_BASE=http://localhost:11434/v1
#   LLM_OPENWEIGHT_API_KEY=ollama
LLM_OPENWEIGHT_API_BASE=http://localhost:11434/v1
LLM_OPENWEIGHT_API_KEY=ollama

# ── Option C: Direct provider keys (sota_eval.py auto-detects) ──────────────
# Alternatively export provider-native keys and configure OpenAI-compatible gateway to route them.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
