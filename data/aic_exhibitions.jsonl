{"id": "aic_exh_5", "source": "aic", "title": "AIC: Manet and the Sea", "theme": "Manet and the Sea", "description": "This landmark exhibition is devoted to the marine paintings of Edouard Manet (1832–1883), a little-studied but highly significant aspect of the career of the artist who is sometimes referred to as the father of Impressionism.", "start_date": "2003-10-20T00:00:00-05:00", "end_date": "2004-01-04T00:00:00-06:00", "object_ids": ["aic_81572", "aic_44892", "aic_14598", "aic_81557", "aic_103101", "aic_81533", "aic_14620"]}
{"id": "aic_exh_211", "source": "aic", "title": "AIC: Toulouse-Lautrec and Montmartre", "theme": "Toulouse-Lautrec and Montmartre", "description": "Henri de Toulouse-Lautrec (1864–1901), one of the most popular and important painters of late-19th-century Paris, has not been the subject of a major exhibition since the large retrospective presented in London and Paris in 1991 and 1992. The National Gallery of Art and the Art Institute of Chicago have collaborated to organize Toulouse-Lautrec and Montmartre, an exhibition that places the artist's work at the peak of his career between 1888 and 1896 in conjunction with the work of other artists of the period.", "start_date": "2005-07-16T00:00:00-05:00", "end_date": "2005-10-10T00:00:00-05:00", "object_ids": ["aic_61128", "aic_27954", "aic_125986", "aic_13560", "aic_111929", "aic_125990", "aic_125981", "aic_7666", "aic_7672", "aic_21092", "aic_43554", "aic_20321", "aic_36036", "aic_7611", "aic_8803", "aic_54723", "aic_7638", "aic_4596", "aic_7644", "aic_7615", "aic_7657", "aic_125982", "aic_125987", "aic_7662", "aic_7669", "aic_7659", "aic_125985", "aic_74662", "aic_7683", "aic_7650", "aic_7640", "aic_7679", "aic_7653", "aic_7675", "aic_7685", "aic_7647", "aic_125983", "aic_14664", "aic_125988", "aic_119444", "aic_125989", "aic_125984", "aic_7635", "aic_16146", "aic_89517", "aic_36005", "aic_132001", "aic_36007", "aic_132003", "aic_36008", "aic_36010", "aic_36003", "aic_36004", "aic_132002", "aic_36009", "aic_67181", "aic_36002", "aic_145907", "aic_63598", "aic_9148", "aic_65089", "aic_81566"]}
