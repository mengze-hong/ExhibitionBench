{"id": "aic_exh_305", "source": "aic", "title": "AIC: Connoisseurship of Japanese Prints\n Part II: Contemporary Artists", "theme": "Connoisseurship of Japanese Prints\n Part II: Contemporary Artists", "description": "Continuing with the theme of the previous exhibition which explored issues of connoisseurship in Edo period (1615-1868) prints, the current display tackles these questions for from the mid- to late 20th century.", "start_date": "2006-03-04T00:00:00-06:00", "end_date": "2006-05-07T00:00:00-05:00", "object_ids": ["aic_14170", "aic_14175", "aic_32138", "aic_130150", "aic_130151", "aic_130152", "aic_130154", "aic_130155", "aic_130156", "aic_130157", "aic_99365", "aic_99366", "aic_16320", "aic_45620", "aic_109281", "aic_109282", "aic_84190", "aic_84192", "aic_16296", "aic_111127", "aic_84194", "aic_84196", "aic_136265", "aic_16227", "aic_84184", "aic_84187", "aic_16194", "aic_111144", "aic_130209", "aic_12328", "aic_84181", "aic_14217", "aic_94203"]}
{"id": "aic_exh_470", "source": "aic", "title": "AIC: Foreign Faces in Japanese Prints", "theme": "Foreign Faces in Japanese Prints", "description": "Like people around the world, the Japanese of the Edo period (1615–1868) found foreigners fascinating, and woodblock print (ukiyo-e) artists and publishers were only too happy to accommodate the public’s appetite. Foreign Faces in Japanese Prints presents a range of works by some of the most prominent ukiyo-e artists of the 17th through 19th century, including Hishikawa Moronobu, Okumura Masanobu, Suzuki Harunobu, Kitagawa Utamaro, and Katsushika Hokusai. Printed books and lacquerware with foreign imagery are also on display.", "start_date": "2007-01-20T00:00:00-06:00", "end_date": "2007-04-08T00:00:00-05:00", "object_ids": ["aic_31779", "aic_21571", "aic_21670", "aic_2920", "aic_19055", "aic_44164", "aic_44353", "aic_19101", "aic_7578", "aic_19502", "aic_31945", "aic_23443", "aic_23447", "aic_89064", "aic_89059", "aic_23012", "aic_31506", "aic_6737", "aic_6722", "aic_6733", "aic_6729", "aic_6725", "aic_6741", "aic_35361", "aic_23476", "aic_57791", "aic_88275", "aic_38550", "aic_48619", "aic_21249", "aic_22673", "aic_14813", "aic_2914", "aic_86971", "aic_44384", "aic_189624", "aic_189647", "aic_189659", "aic_189661"]}
{"id": "aic_exh_3059", "source": "aic", "title": "AIC: The City as Image: The 1909 Plan of Chicago", "theme": "The City as Image: The 1909 Plan of Chicago", "description": "An integral part of the historic plan’s enduring influence, Jules Guérin’s monumental watercolors constitute a powerful pictorial narrative about the nature and goals of urban change.", "start_date": "2015-11-10T00:00:00-06:00", "end_date": "2016-03-27T00:00:00-05:00", "object_ids": ["aic_90737", "aic_196336", "aic_196323", "aic_196398", "aic_196393", "aic_196359", "aic_196352", "aic_196350"]}
{"id": "aic_exh_2139", "source": "aic", "title": "AIC: Gates of the Lord: The Tradition of Krishna Paintings", "theme": "Gates of the Lord: The Tradition of Krishna Paintings", "description": "The first U.S. presentation of the art and aesthetics of the Pushtimarg sect of Hinduism, this exhibition features over 100 paintings and pichvais celebrating Shrinathji, a form of Krishna.", "start_date": "2015-09-13T00:00:00-05:00", "end_date": "2016-01-03T00:00:00-06:00", "object_ids": ["aic_131908", "aic_218464", "aic_223332", "aic_131815", "aic_136981", "aic_32285", "aic_228331", "aic_14849", "aic_191321", "aic_234000"]}
{"id": "aic_exh_1606", "source": "aic", "title": "AIC: Undressed: The Fashion of Privacy", "theme": "Undressed: The Fashion of Privacy", "description": "More than 120 drawings and prints, as well as works in other media, offer a behind-the-scenes perspective on dress and undress, the fascinating flip side of the very public face of high fashion.", "start_date": "2013-06-22T00:00:00-05:00", "end_date": "2013-09-29T00:00:00-05:00", "object_ids": ["aic_63482", "aic_191564", "aic_39508", "aic_82071", "aic_96775", "aic_64982", "aic_13506", "aic_36003", "aic_88384", "aic_45808", "aic_83638", "aic_3433", "aic_60723", "aic_73386", "aic_145875", "aic_185911", "aic_68369", "aic_25845", "aic_84587", "aic_86425", "aic_84589", "aic_84593", "aic_84598", "aic_17265", "aic_59772", "aic_17267", "aic_65814", "aic_36010", "aic_21522", "aic_133143", "aic_23599", "aic_62164", "aic_160076", "aic_55312", "aic_59817", "aic_79895", "aic_122749", "aic_44072", "aic_17343", "aic_198297", "aic_27875", "aic_147864", "aic_180671", "aic_111372", "aic_104929", "aic_66816", "aic_13514", "aic_63381", "aic_132001", "aic_36008", "aic_36009", "aic_132003", "aic_3419", "aic_25756", "aic_50883", "aic_93425", "aic_45245", "aic_60694", "aic_37056", "aic_42958", "aic_27496", "aic_58514", "aic_45234", "aic_51807", "aic_117689", "aic_141892", "aic_141894", "aic_141896", "aic_141897", "aic_89777", "aic_89906", "aic_89772", "aic_89762", "aic_61488", "aic_61491", "aic_61493", "aic_13524", "aic_13531", "aic_28826", "aic_77603", "aic_43827", "aic_13527", "aic_90178", "aic_27450", "aic_27844", "aic_3446", "aic_49160", "aic_56045", "aic_82499", "aic_63325", "aic_55803", "aic_49319", "aic_66146", "aic_49355", "aic_149050", "aic_103103", "aic_49381", "aic_84474", "aic_61169", "aic_129133", "aic_185833", "aic_113856", "aic_214263", "aic_136956", "aic_186098", "aic_78919", "aic_78963", "aic_78901", "aic_78959", "aic_78958", "aic_60650", "aic_29022"]}
