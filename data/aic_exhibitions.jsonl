{"id": "aic_exh_408", "source": "aic", "title": "AIC: The Floating World Emerges: Selections from the Clarence Buckingham Collection, Part I", "theme": "The Floating World Emerges: Selections from the Clarence Buckingham Collection, Part I", "description": "Featuring the museum’s earliest and most famous ukiyo-e prints, or “pictures of the floating world,” this exhibition includes approximately 35 works dating from the late 17th to the first half of the 18th century.", "start_date": "2005-03-19T00:00:00-06:00", "end_date": "2005-05-24T00:00:00-05:00", "object_ids": ["aic_110305", "aic_19058", "aic_19066", "aic_30113", "aic_30117", "aic_30119", "aic_30123", "aic_30126", "aic_30130", "aic_21564", "aic_140939", "aic_19169", "aic_5912", "aic_54767", "aic_13671", "aic_54770", "aic_44137", "aic_19183", "aic_158921", "aic_21561", "aic_19186", "aic_44343", "aic_8208", "aic_19597", "aic_13690", "aic_21447", "aic_88904", "aic_19324", "aic_44149", "aic_19900", "aic_19913", "aic_18589", "aic_188948", "aic_188949", "aic_188950", "aic_188952", "aic_188953", "aic_188954"]}
{"id": "aic_exh_722", "source": "aic", "title": "AIC: The Divine Art: Four Centuries of European Tapestries", "theme": "The Divine Art: Four Centuries of European Tapestries", "description": "For the first time in the history of the Art Institute, nearly all of its unparalleled tapestry collection is featured in a spectacular presentation. After decades in storage, these monumental artworks were subject to one of the largest tapestry conservation projects ever undertaken by a private workshop. Freshly conserved to their full splendor, The Divine Art's 70 masterpieces will only be on view for two months and then will return to storage, so be sure to catch these majestic works at their best—dazzling the eye beyond expectation.", "start_date": "2008-11-01T00:00:00-05:00", "end_date": "2009-01-04T00:00:00-06:00", "object_ids": ["aic_6789", "aic_114925", "aic_25737", "aic_110099", "aic_110098", "aic_111843", "aic_50905", "aic_54748", "aic_6792", "aic_111307", "aic_25958", "aic_25960", "aic_65167", "aic_189775", "aic_463", "aic_464", "aic_79796", "aic_96697", "aic_58661", "aic_73059", "aic_73058", "aic_73269", "aic_78972", "aic_2581", "aic_7957", "aic_135326", "aic_22248", "aic_78965", "aic_79537", "aic_78969", "aic_40724", "aic_151988", "aic_27849", "aic_14696", "aic_96698", "aic_80479", "aic_49660", "aic_49208", "aic_27834", "aic_151990", "aic_49222", "aic_49225", "aic_105700", "aic_75668", "aic_139798", "aic_44415", "aic_2102", "aic_8619", "aic_9756", "aic_80482", "aic_27847", "aic_26006", "aic_94608", "aic_76634", "aic_31232", "aic_18166", "aic_64700", "aic_151038", "aic_49664", "aic_49670", "aic_49673", "aic_49676", "aic_49678", "aic_142548", "aic_147057", "aic_151037", "aic_147056", "aic_147055", "aic_147053", "aic_147054", "aic_49667", "aic_462", "aic_92868", "aic_152180"]}
{"id": "aic_exh_9202", "source": "aic", "title": "AIC: Photography + Folk Art: Looking for America in the 1930s", "theme": "Photography + Folk Art: Looking for America in the 1930s", "description": "<p>Over 100 works of photography, decorative arts, painting, sculpture, and textiles evidence the country’s search for, and eventual discovery of, a distinctly American character and vitality during the Great Depression.&nbsp;</p>", "start_date": "2019-09-21T00:00:00-05:00", "end_date": "2020-01-20T00:00:00-06:00", "object_ids": ["aic_88584", "aic_88591", "aic_13724", "aic_13730", "aic_13773"]}
{"id": "aic_exh_2724", "source": "aic", "title": "AIC: Ink on Paper: Japanese Monochromatic Prints (2016)", "theme": "Ink on Paper: Japanese Monochromatic Prints", "description": "Spanning nearly 250 years, this selection of prints showcases the simple and striking use of dark ink on paper from the years before color printing.", "start_date": "2016-11-12T00:00:00-06:00", "end_date": "2017-01-29T00:00:00-06:00", "object_ids": ["aic_16272", "aic_19069", "aic_19151", "aic_19609", "aic_22860", "aic_22867", "aic_22946", "aic_23474", "aic_23932", "aic_25242", "aic_25293", "aic_25966", "aic_25969", "aic_41357", "aic_44098", "aic_45716", "aic_45727", "aic_58530", "aic_58533", "aic_58544", "aic_58548", "aic_58549", "aic_87083", "aic_88492", "aic_88495", "aic_88506", "aic_99368", "aic_185390", "aic_185391"]}
{"id": "aic_exh_9990", "source": "aic", "title": "AIC: A Field Guide to Photography and Media", "theme": "A Field Guide to Photography and Media", "description": "<p>Celebrating the history and impact of photography through the Art Institute’s collection, this exhibition features more than 150 works that cut across time, space, and genre.</p>", "start_date": "2022-11-19T00:00:00-06:00", "end_date": "2023-04-10T00:00:00-05:00", "object_ids": ["aic_2964", "aic_227001", "aic_230328", "aic_223896", "aic_199171", "aic_242557", "aic_214196", "aic_29276", "aic_140434", "aic_224997"]}
{"id": "aic_exh_10095", "source": "aic", "title": "AIC: Picasso: Drawing from Life", "theme": "Picasso: Drawing from Life", "description": "<p>Tracing over 70 years in the artist's prolific and varied practice, this selection of prints and drawings highlights the relationships that were integral to&nbsp;Picasso's career—from friends and lovers to dealers and printers—revealing not a solitary genius but an artist intimately connected to and buoyed by others.</p>", "start_date": "2023-11-11T00:00:00-06:00", "end_date": "2024-04-08T00:00:00-05:00", "object_ids": ["aic_68414", "aic_75420", "aic_51364", "aic_53111", "aic_79377", "aic_180666", "aic_78842"]}
{"id": "aic_exh_9723", "source": "aic", "title": "AIC: Christina Ramberg: A Retrospective", "theme": "Christina Ramberg: A Retrospective", "description": "<p>This comprehensive exhibition includes Ramberg's well-known figural works as well as her lesser-known quilts, mid-career paintings, late abstractions, and ephemera from her informal archive.</p>", "start_date": "2024-04-18T00:00:00-05:00", "end_date": "2024-08-11T00:00:00-05:00", "object_ids": ["aic_154855", "aic_154869", "aic_154857", "aic_154858", "aic_154853"]}
{"id": "aic_exh_10097", "source": "aic", "title": "AIC: Four Chicago Artists: Theodore Halkin, Evelyn Statsinger, Barbara Rossi, and Christina Ramberg", "theme": "Four Chicago Artists: Theodore Halkin, Evelyn Statsinger, Barbara Rossi, and Christina Ramberg", "description": "<p>The exhibition brings together 95 works by four Chicago artists to showcase how their lives intersected across generations to shape the visual culture of our inimitable city.</p>", "start_date": "2024-05-11T00:00:00-05:00", "end_date": "2024-08-26T00:00:00-05:00", "object_ids": ["aic_154860", "aic_99551", "aic_28716", "aic_116577", "aic_94117"]}
